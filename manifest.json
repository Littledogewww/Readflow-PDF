{
  "manifest_version": 3,
  "name": "ReadFlow PDF - 顺流阅读助手",
  "version": "2.0.0",
  "description": "沉浸式 PDF 阅读与划词收集工具，支持书架管理、AI 翻译、全屏模式、自定义主题色及 Anki 导出。",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReadFlow PDF"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdfjs-viewer/web/*",
        "pdfjs-viewer/web/**/*",
        "pdfjs-viewer/build/*",
        "pdfjs-viewer/build/**/*",
        "library.html",
        "library.js",
        "library.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
